# Daski minimal provider — Base Sepolia / Testnet template
# Copy to .env, replace every REPLACE_* value, and never commit .env.

NODE_ENV=development
PORT=4000
BASE_URL=https://REPLACE_WITH_YOUR_PUBLIC_PROVIDER_ORIGIN
GATEWAY_BASE_URL=https://REPLACE_WITH_DASKI_TESTNET_GATEWAY_ORIGIN
CHAIN_MODE=live

PROVIDER_NAME=REPLACE_WITH_YOUR_LEGAL_PROVIDER_NAME
PROVIDER_DESCRIPTION=REPLACE_WITH_A_SHORT_PUBLIC_DESCRIPTION
PROVIDER_WEBSITE_URL=https://REPLACE_WITH_YOUR_WEBSITE
PROVIDER_ICON_URL=https://REPLACE_WITH_YOUR_ICON
MARKETPLACE_TERMS_URL=https://REPLACE_WITH_DASKI_TERMS
MARKETPLACE_PRIVACY_URL=https://REPLACE_WITH_DASKI_PRIVACY_NOTICE
PROVIDER_TERMS_URL=https://REPLACE_WITH_YOUR_PROVIDER_TERMS
PROVIDER_PRIVACY_URL=https://REPLACE_WITH_YOUR_PRIVACY_NOTICE
SUPPORT_EMAIL=support@example.com
SUPPORT_RESPONSE_SLA=1 business day

# The database stores only replay/idempotency state, admitted public chain
# evidence, rate-limit buckets, terminal results, and optional supplier intent.
DATABASE_URL=postgresql://daski_provider:local-only-provider-password@127.0.0.1:55432/daski_provider
DATABASE_SSL_MODE=disable
# Production requires a separate schema owner and verify-full TLS:
# MIGRATION_DATABASE_URL=postgresql://schema_owner:REPLACE@db.example/provider
# DATABASE_CA_CERT=REPLACE_WITH_PEM_CONTENT

CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
BASE_RPC_FALLBACK_URLS=
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
USDC_ADDRESS=0x036cbd53842c5426634e7929541ec2318f3dcf7e
PROVIDER_AGENT_ID=REPLACE_WITH_ERC_8004_AGENT_ID
PROVIDER_WALLET_PRIVATE_KEY=0xREPLACE_WITH_64_HEX_TESTNET_PRIVATE_KEY
# After a wallet rotation, keep each previous key until no order admitted
# under its listing versions remains (comma-separated; secret).
# PROVIDER_RETAINED_WALLET_PRIVATE_KEYS=
# Payer-signed lifecycle reads: eoa, or eoa,contract to also verify deployed
# ERC-1271 wallets through the RPC URLs above.
PAYER_ACCOUNT_TYPES=eoa

# Daski issues/reviews this set during Testnet onboarding.
STANDARD_RAIL_ENVIRONMENT=testnet
STANDARD_RAIL_GATEWAY_SIGNER=0xREPLACE_WITH_GATEWAY_PROTOCOL_SIGNER
STANDARD_RAIL_GATEWAY_ORIGIN=https://REPLACE_WITH_DASKI_TESTNET_GATEWAY_ORIGIN
STANDARD_RAIL_GATEWAY_AUDIENCE=https://REPLACE_WITH_DASKI_TESTNET_GATEWAY_ORIGIN
STANDARD_RAIL_PROVIDER_AUDIENCE=https://REPLACE_WITH_YOUR_PUBLIC_PROVIDER_ORIGIN
# After an origin move, previous provider audiences old orders still name
# (servicing calls only; keep the old origin routed to this provider).
# STANDARD_RAIL_RETAINED_PROVIDER_AUDIENCES=
REPUTATION_STORAGE_ADDRESS=0xREPLACE_WITH_REPUTATION_STORAGE
EAS_ADDRESS=0x4200000000000000000000000000000000000021
EAS_RUNTIME_CODE_HASH=0xREPLACE_WITH_64_HEX_RUNTIME_CODE_HASH
EAS_OUTCOME_SCHEMA_UID=0xREPLACE_WITH_64_HEX_SCHEMA_UID
SANCTIONS_ORACLE_ADDRESS=0xREPLACE_WITH_SANCTIONS_ORACLE
# Daski supplies both values with the reviewed runtime bundle. Keep the JSON
# byte-for-byte as issued; do not hand-edit signed policy envelopes.
STANDARD_RAIL_GLOBAL_POLICY_JSON=REPLACE_WITH_DASKI_ISSUED_GLOBAL_POLICY_JSON
STANDARD_RAIL_PROVIDER_CONTROL_PROFILE_HASH=0xREPLACE_WITH_64_HEX_CONTROL_PROFILE_HASH
# After a control-profile change, each previous profile hash orders quoted
# under it may still carry (comma-separated bytes32; at most 16).
# STANDARD_RAIL_RETAINED_CONTROL_PROFILE_HASHES=
STANDARD_RAIL_FINALITY_CONFIRMATIONS=12

# External-job state encryption: required only to admit external jobs and
# while stored jobs name a key. Generate with: openssl rand -hex 32 (add 0x).
# PROVIDER_DATA_ENCRYPTION_KEY=
# PROVIDER_DATA_ENCRYPTION_KEY_ID=primary
# After a rotation, previous read-only keys as key-id=0x<64 hex>, comma-separated.
# PROVIDER_DATA_ENCRYPTION_PREVIOUS_KEYS=
# External-job worker defaults (docs/configuration.md); change only if needed.
# EXTERNAL_JOB_CALL_TIMEOUT_MS=30000
# EXTERNAL_JOB_LEASE_SECONDS=90
# EXTERNAL_JOB_LEASE_RENEW_MS=20000
# EXTERNAL_JOB_MAX_CONCURRENT_CALLS=4
# EXTERNAL_JOB_POLL_INTERVAL_SECONDS=60
# EXTERNAL_JOB_OVERDUE_POLL_SECONDS=300

# Independent secret used only to pseudonymize local rate-limit identities.
# Generate with: openssl rand -hex 32
RATE_LIMIT_HASH_KEY=REPLACE_WITH_AT_LEAST_32_HIGH_ENTROPY_CHARACTERS
RATE_LIMIT_BYPASS_IPS=
TRUST_PROXY_HOPS=0
TRUST_PROXY_CIDRS=
EDGE_RATE_LIMIT_VERIFIED=false

# Add product-specific credentials below. Parse them in
# src/services/<slug>/config.ts; never put them in manifests or docs.
